<odoo>
    <!-- Report Definition -->
    <record id="report_orion_sale_order" model="ir.actions.report">
        <field name="name">Orion Domestic Quotation</field>
        <field name="type">ir.actions.report</field>
        <field name="model">sale.order</field>
        <field name="report_name">orion_sale_report.report_sale_order</field>
        <field name="report_type">py3o</field>
        <field name="py3o_filetype">odt</field>
        <field name="module">orion_sale_report</field>
        <field name="py3o_template_fallback">reports/orion_sales_quotation_report.odt</field>  <!-- Ensure correct path here -->
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>


    <!-- Print Action to trigger the report -->
    <record id="action_generate_py3o_report_action" model="ir.actions.server">
        <field name="name">Generate Py3O Quotation Report</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">action = model.action_generate_py3o_report()</field>
    </record>
</odoo>


