        <!-- Orion Quotation Technical Report -->
        <record id="report_orion_sale_order" model="ir.actions.report">
            <field name="name">Orion Quotation Technical</field>
            <field name="type">ir.actions.report</field>
            <field name="model">sale.order</field>
            <field name="report_name">orion_sale_report.report_sale_order</field>
            <field name="report_type">py3o</field>
            <field name="py3o_filetype">odt</field>
            <field name="module">orion_sale_report</field>
            <field name="py3o_template_fallback">reports/orion_sale_technical_quotation.odt</field>

            <field name="print_report_name">'%s' % object.name</field>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
            <field name="binding_type">report</field>
        </record>


