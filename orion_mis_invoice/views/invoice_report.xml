<odoo>
    <record id="invoice_report" model="ir.actions.report">
        <field name="name">Py3o Sales-OA Pending Report</field>
        <field name="model">orion_mis_invoice.invoicewise</field>
        <field name="report_name">orion_mis_invoice.invoice_report</field>
        <field name="report_type">py3o</field>
        <field name="py3o_filetype">odt</field>
        <field name="module">orion_mis_invoice</field>
        <!--        <field name="py3o_template_fallback">reports/sales_invoice.odt</field>-->
        <field name="py3o_template_fallback">reports/sold_out.odt</field>
        <!--        <field name="print_report_name">'Invoice Report - %s' % (object.partner_id.name if object.partner_id else-->
        <!--            'Unknown')-->
        <!--        </field>-->
        <field name="print_report_name">
            'MIS_Invoice_report_%s_TO_%s' % (
            object.from_date.strftime("%d_%b_%Y").lower(),
            object.to_date.strftime("%d_%b_%Y").lower()
            )
        </field>

    </record>

</odoo>