<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- RFQ Sequence -->
        <record id="seq_purchase_rfq" model="ir.sequence">
            <field name="name">RFQ Sequence</field>
            <field name="code">purchase.rfq</field>
            <field name="prefix">RFQ%(y)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- PO Sequence -->
        <record id="seq_purchase_po" model="ir.sequence">
            <field name="name">PO Sequence</field>
            <field name="code">purchase.po</field>
            <field name="prefix">PO%(y)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

    </data>
</odoo>