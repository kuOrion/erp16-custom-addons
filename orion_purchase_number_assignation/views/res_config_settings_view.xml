<odoo>
    <record id="view_purchase_settings_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.purchase.sequence</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <!-- Minimal: just find the form tag and add after sheet -->
            <xpath expr="//form" position="inside">
                <div class="app_settings_block" data-string="Purchase Sequence" string="Purchase Sequence">
                    <h2>Purchase Sequence</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">RFQ Prefix</span>
                                <div class="content-group mt8">
                                    <field name="rfq_prefix" placeholder="e.g. RFQ"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">PO Prefix</span>
                                <div class="content-group mt8">
                                    <field name="po_prefix" placeholder="e.g. PO"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>

        </field>
    </record>
</odoo>