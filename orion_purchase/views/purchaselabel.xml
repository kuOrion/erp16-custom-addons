<odoo>

    <record id="view_purchase_order_form_inherit_orion" model="ir.ui.view">
        <field name="name">purchase.order.form.orion</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">

                <!-- Parus Tax Terms Tab -->
                <page string="Orion Tax Terms">
                    <group>
                        <group>

                            <field name="payment_term"
                                   options="{'no_create': False, 'no_open': False}"/>

                            <field name="mode_of_payment_id"
                                   options="{'no_create': False, 'no_open': False}"/>

                            <field name="freight_id"
                                   options="{'no_create': False, 'no_open': False}"/>

                            <field name="inspection_id"
                                   options="{'no_create': False, 'no_open': False}"/>

                            <field name="insurance_id"
                                   options="{'no_create': False, 'no_open': False}"/>

                        </group>

                        <group>

                            <field name="delivery"/>

                            <field name="packing_id"
                                   options="{'no_create': False, 'no_open': False}"/>

                            <field name="mode_of_transport_id"
                                   options="{'no_create': False, 'no_open': False}"/>

                            <field name="note"/>

                        </group>
                    </group>
                </page>

            </xpath>

        </field>
    </record>

</odoo>
