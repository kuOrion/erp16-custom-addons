<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_attribute_value_view_form_inherit_sh_product_configurator"
            model="ir.ui.view">
        <field name="name">product.template.attribute.value.form.inherit.sh.product.configurator</field>
        <field name="model">product.template.attribute.value</field>
        <field name="inherit_id" ref="product.product_template_attribute_value_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet/group" position="before">
                <field name="product_tmpl_id" invisible="1"/>
            </xpath>

            <!-- Add description before exclude_for -->
            <xpath expr="//field[@name='exclude_for']" position="before">
                <field name="description" placeholder="Description"/>
            </xpath>

            <!-- New implementation for hierarchical attributes -->
            <xpath expr="//field[@name='exclude_for']" position="after">
                <separator string="Sub-Attributes"/>
                <field name="child_attribute_line_ids" widget="one2many" context="{'default_product_tmpl_id': product_tmpl_id, 'default_parent_attribute_value_id': id, 'show_attribute': False}">
                    <tree string="Attributes" editable="bottom">
                        <field name="attribute_id" domain="[('id', '=', -1)]"/>
                        <field name="value_ids" widget="many2many_tags" options="{'no_create_edit': True, 'can_open': True, 'color_field': 'color'}" domain="[('attribute_id', '=', attribute_id), ('id', '=', -1)]" context="{'default_attribute_id': attribute_id,'show_attribute': False}"/>
                        <button string="Configure" class="float-end btn-secondary" type="object" name="action_open_attribute_values" groups="product.group_product_variant"/>
                    </tree>
                </field>
            </xpath>

            <!-- Stay inside the same group; don't create a new group -->
            <!-- <xpath expr="//field[@name='exclude_for']" position="after">
                <field name="sh_child_attribute_name_char"/>
                <field name="sh_value_ids">
                    <tree editable="bottom">
                        <field name="sequence" widget="handle"/>
                        <field name="name"/>
                        <field name="product_attribute_value_id_direct" invisible="1"/>
                        <field name="description" optional="show"/>
                        <field name="is_custom" groups="product.group_product_variant"/>
                    </tree>
                </field>
            </xpath> -->
        </field>
    </record>


    <record id="product_template_attribute_value_view_tree_inherit_sh_product_configurator" model="ir.ui.view">
        <field name="name">product.template.attribute.value.tree.inherit.sh.product.configurator</field>
        <field name="model">product.template.attribute.value</field>
        <field name="inherit_id" ref="product.product_template_attribute_value_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="description" optional="show" />
            </xpath>
        </field>
    </record>
</odoo>
