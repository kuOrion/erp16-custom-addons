<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sh_inherit_view_form_config_setting" model="ir.ui.view">
        <field name="name">sh.inherit.view.form.config.setting</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='companies']" position="after">
                <h2>Product Internal Reference Generator Feature</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="sh_product_int_ref_gen"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label string="Product internal reference generator feature" for="sh_product_int_ref_gen"/>
                            </div>
                        </div>
                        
                        <div class="col-12 col-lg-6 o_setting_box" attrs="{'invisible': [('sh_product_int_ref_gen', '=', False)]}">
                            <label string="Product sequence separate" for="sh_pdt_seq_sep"/>
                            <field name="sh_pdt_seq_sep"/>
                            <div class="content-group">
                                <div class="mt8">
                                    <button type="object" name="generate_int_ref" string="GENERATE INTERNAL REFERENCE FOR ALL PRODUCT" class="btn btn-primary"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box" attrs="{'invisible': [('sh_product_int_ref_gen', '=', False)]}">
                            <div>
                                <label for="sh_pdt_attr_digit"/>
                                <field name="sh_pdt_attr_digit" />
                            </div>
                                <br/>
                            <div>
                                <label for="sh_pdt_new_seq_sep"/>
                                <field name="sh_pdt_new_seq_sep" />
                            </div>
                        </div>
                    </div>
            </xpath>
        </field>
    </record>
</odoo>