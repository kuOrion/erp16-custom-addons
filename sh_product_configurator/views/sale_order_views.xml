<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_sh_product_configurator" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.sh_product_configurator</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <!-- Higher than default 16 so we run after most views -->
        <field name="priority">100</field>

        <field name="arch" type="xml">
            <!-- SAME xpath as the other inherited view -->
            <xpath expr="//tree/field[@name='product_template_id']"
                   position="attributes">
                <attribute name="groups">base.group_system</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_order_form_inherit_sale_product_configurator" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.sale_product_configurator</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_product_configurator.sale_order_view_form"/>
        <!-- Higher than default 16 so we run after most views -->
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//tree/field[@name='product_id']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
        </field>
    </record>
</odoo>
