<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="sale_order_tree_round_total" model="ir.ui.view">
        <field name="name">sale.order.tree.round.total</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">

            <!-- Replace default Total -->
            <xpath expr="//field[@name='amount_total']" position="replace">
                <field name="amount_total_round" widget="monetary"/>
            </xpath>

        </field>
    </record>

</odoo>