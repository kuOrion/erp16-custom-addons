<odoo>
    <data>
        <record id="view_orion_product_form" model="ir.ui.view">
            <field name="name">view.orion_product.form</field>
            <field name="model">product.product</field>
            <field name="priority">55</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">
                <!-- Remove the original default_code field -->
                <field name="default_code" position="attributes">
                    <attribute name="invisible">1</attribute>
                </field>

                <!-- Add the customized default_code field before the notebook -->
                <xpath expr="//notebook" position="before">
                    <div class="oe_title">
                        <label for="default_code" class="oe_edit_only"/>
                        <h2>
                            <field name="default_code" placeholder="Internal Reference"/>
                        </h2>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>