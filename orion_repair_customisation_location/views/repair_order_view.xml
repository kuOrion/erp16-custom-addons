<odoo>
    <!-- Form View -->
    <record id="view_repair_order_form_dispatch" model="ir.ui.view">
        <field name="name">repair.order.form.dispatch</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form"/>
        <field name="arch" type="xml">

            <!-- Add Status Bar -->
            <xpath expr="//header/field[@name='state']" position="before">
                <field name="location_status" widget="statusbar"
                       statusbar_visible="draft,dispatched,received,returned,received_dispatch,completed"/>
            </xpath>

            <!-- Add Buttons -->
            <xpath expr="//header/field[@name='state']" position="after">
                <field name="return_dispatch_date" invisible="1"/>
                <field name="received_in_dispatch_date" invisible="1"/>

                <button name="action_set_dispatched"
                        string="Mark as Dispatched"
                        type="object"
                        class="btn-primary"
                        attrs="{'invisible': [('location_status', '!=', 'draft')]}"/>

                <button name="action_receive_in_warehouse"
                        string="Receive in Warehouse"
                        type="object"
                        class="btn-success"
                        attrs="{'invisible': [('location_status', '!=', 'dispatched')]}"/>

                <button name="action_transfer_to_dispatch"
                        string="Transfer to Dispatch"
                        type="object"
                        class="btn-warning"
                        attrs="{'invisible': [('location_status', '!=', 'received')]}"/>

                <button name="action_receive_in_dispatch"
                        string="Receive in Dispatch"
                        type="object"
                        class="btn-info"
                        attrs="{'invisible': [('location_status', '!=', 'returned')]}"/>

                <button name="action_create_invoice"
                        string="Create Invoice"
                        type="object"
                        class="btn-primary"
                        confirm="This will create the invoice. Continue?"
                        attrs="{'invisible': [('location_status', '!=', 'received_dispatch')]}"/>
            </xpath>

            <!-- Hide standard invoice button -->
            <xpath expr="//button[@name='action_repair_invoice_create']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Add Location Tab -->
            <xpath expr="//notebook" position="inside">
                <page string="Location Tracking">
                    <group>
                        <group string="Dispatch">
                            <field name="dispatch_location_id"/>
                            <field name="dispatch_date" readonly="1"/>
                            <field name="received_in_dispatch_date" readonly="1"/>
                        </group>
                        <group string="Warehouse">
                            <field name="warehouse_location_id"/>
                            <field name="warehouse_received_date" readonly="1"/>
                            <field name="return_dispatch_date" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_repair_order_tree_dispatch" model="ir.ui.view">
        <field name="name">repair.order.tree.dispatch</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="location_status"/>
            </xpath>
        </field>
    </record>

</odoo>