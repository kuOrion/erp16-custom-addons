<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_line_form_specification" model="ir.ui.view">
        <field name="name">purchase.order.line.form.specification</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Add specification field in tree view -->
            <xpath expr="//field[@name='order_line']/tree/field[@name='name']" position="after">
                <field name="specification" optional="show"/>
            </xpath>

            <!-- Add specification field in form view -->
            <xpath expr="//field[@name='order_line']/form//field[@name='name']" position="after">
                <field name="specification" placeholder="Enter product specifications..."/>
            </xpath>
        </field>
    </record>
</odoo>