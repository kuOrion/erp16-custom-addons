    <odoo>
        <record id="view_purchase_order_form_tax_auto" model="ir.ui.view">
            <field name="name">purchase.order.form.tax.auto</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <!-- Ensure onchange when fiscal position changes -->
                <field name="fiscal_position_id" position="attributes">
                    <attribute name="on_change">1</attribute>
                    <attribute name="force_save">1</attribute>
                    <attribute name="attrs">{'invisible': [('state', 'in', ['purchase', 'done', 'cancel'])]}</attribute>
                </field>
            </field>
        </record>
    </odoo>
