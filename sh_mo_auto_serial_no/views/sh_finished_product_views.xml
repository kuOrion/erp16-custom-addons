<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sh_finished_product_tree" model="ir.ui.view">
        <field name="name">sh.finished.product.tree</field>
        <field name="model">sh.finished.product</field>
        <field name="priority">2</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="product_id"/>
                <field name="sh_product_qty"/>
                <button name="sh_show_details_action" type="object" title="Show Details" icon="fa-list"/>
            </tree>
        </field>
    </record>

    <record id="view_sh_finished_product_form" model="ir.ui.view">
        <field name="name">sh.finished.product.form</field>
        <field name="model">sh.finished.product</field>
        <field name="arch" type="xml">
            <form string="Finished Product" >
                <sheet>
                    <group>
                        <field name="product_id" readonly='1'/>
                        <field name="sh_product_qty" readonly='1'/>
                        <field name="production_id" readonly='1'/>                        
                    </group>
                    <notebook>
                        <page name="sh_serial_number" string="Serial Number">
                            <field name="lot_ids">
                                <tree create="false" delete="false" edit="false" no_open="1">
                                    <field name="name"/>
                                    <field name="product_qty"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    

    <record id="action_sh_finished_product" model="ir.actions.act_window">
        <field name="name">Finished Product</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sh.finished.product</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
            Create a new Finished Product!
            </p>
        </field>
    </record>

</odoo>
