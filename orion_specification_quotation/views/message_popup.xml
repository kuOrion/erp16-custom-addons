<odoo>
    <!-- Sale Order Form View Inheritance -->
    <record id="view_order_form_inherit_n_specification" model="ir.ui.view">
        <field name="name">sale.order.form.n.specification</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Show in tree view of order lines -->
            <xpath expr="//field[@name='order_line']/tree/field[@name='product_id']" position="after">
                <field name="n_specification" readonly="1"/>
            </xpath>
            <!-- Show in form view of order lines -->
            <xpath expr="//field[@name='order_line']/form//field[@name='product_id']" position="after">
                <field name="n_specification" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="product_product_tree_inherit_n_spec" model="ir.ui.view">
        <field name="name">product.product.tree.inherit.n.spec</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">

            <!-- Insert N Specification field as FIRST column -->
            <xpath expr="//tree/field[1]" position="before">
                <field name="n_specification_display" string="N Specification"/>
            </xpath>

        </field>
    </record>

    <!-- Wizard Form View -->
    <record id="view_model_enhancement_confirm_wizard" model="ir.ui.view">
        <field name="name">model.enhancement.confirm.wizard.form</field>
        <field name="model">model.enhancement.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="N Specification" version="7.0">
                <group>
                    <field name="message" readonly="1"/>
                </group>
                <footer>
                    <button string="Confirm" type="object" name="action_confirm" class="btn-primary"/>
                    <button string="Cancel" type="object" name="action_cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>