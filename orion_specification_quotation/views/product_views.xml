<odoo>
    <record id="sale_order_inherit_n_specification" model="ir.ui.view">
        <field name="name">sale.order.form.n.specification</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Tree view inside order_line -->
            <xpath expr="//field[@name='order_line']/tree/field[@name='product_id']" position="after">
                <field name="n_specification" readonly="1"/>
            </xpath>

            <!-- Form view inside order_line -->
            <xpath expr="//field[@name='order_line']/form//field[@name='product_id']" position="after">
                <field name="n_specification" readonly="1"/>
            </xpath>

        </field>
    </record>
</odoo>
