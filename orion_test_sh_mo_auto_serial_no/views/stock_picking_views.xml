<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sh_mo_auto_serial_no_stock_picking_form_view_inherited" model="ir.ui.view">
        <field name="name">sh.stock.picking.inherit.view.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_see_move_scrap']" position="before">
                <button name="action_mo_records" string="MO" type="object"
                            class="oe_stat_button" icon="fa-list"
                            attrs="{'invisible': [('mo_count', '=', 0)]}">
                    <field name="mo_count" widget="statinfo" string="Manufacturing Orders"/>
                </button>
                <button name="action_internal_transfer_records" string="Internal Transfer" type="object"
                            class="oe_stat_button" icon="fa-list"
                            attrs="{'invisible': [('internal_transfer_count', '=', 0)]}">
                    <field name="internal_transfer_count" widget="statinfo" string="Internal Transfer"/>
                </button>
            </xpath>

            <field name='location_id' position="after">
                <!-- Sale Delivery (outgoing) must stay a standard delivery:
                     these MO / Internal Picking selectors are only for
                     manufacturing-related internal stock moves. -->
                <field name="picking_type_code" invisible="1"/>
                <field name='sh_source_mo_id'
                         domain="[('id', 'in', sh_source_mo_ids)]"
                         attrs="{'invisible': [('picking_type_code', '!=', 'internal')], 'readonly': [('state', '=', 'done')]}"/>
                <field name='sh_source_mo_ids' invisible='1' widget="many2many_tags"/>
                <field name='sh_internal_picking_id'
                         domain="[('id', 'in', sh_internal_picking_ids)]"
                         attrs="{'invisible': [('picking_type_code', '!=', 'internal')], 'readonly': [('state', '=', 'done')]}"/>
                <field name='sh_internal_picking_ids' invisible='1' widget="many2many_tags"/>
            </field>
        </field>
    </record>
    <record id="stock.action_picking_tree_ready" model="ir.actions.act_window">
        <field name="name">To Do</field>
        <field name="res_model">stock.picking</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,kanban,form,calendar</field>
        <field name="domain"></field>
        <field name="context">{'contact_display': 'partner_address', 'search_default_available': 1,'operation_type_view':True}</field>
        <field name="search_view_id" ref="stock.view_picking_internal_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No transfer found. Let's create one!
            </p><p>
                Transfers allow you to move products from one location to another.
            </p>
        </field>
   </record>
</odoo>