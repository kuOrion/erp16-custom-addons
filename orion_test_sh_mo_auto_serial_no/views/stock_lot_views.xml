<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sh_mo_auto_serial_no_view_production_lot_form_inherited" model="ir.ui.view">
        <field name="name">sh.stock.lot.inherit.view.form</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Release History" name="sh_serial_release_history" groups="base.group_system">
                    <field name="sh_reassign_log_ids" nolabel="1">
                        <tree create="false" delete="false" edit="false">
                            <field name="action"/>
                            <field name="from_production_id"/>
                            <field name="to_production_id"/>
                            <field name="user_id"/>
                            <field name="create_date"/>
                        </tree>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

    <record id="sh_mo_auto_serial_no_search_product_lot_filter_inherited" model="ir.ui.view">
        <field name="name">sh.stock.lot.inherit.view.search</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.search_product_lot_filter"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="sh_config_prifix_type" string="Serial No Prefix"/>
                <filter string="Released for Reuse" name="sh_filter_released"
                        domain="[('sh_is_released', '=', True)]"/>
                <filter string="Not Released" name="sh_filter_not_released"
                        domain="[('sh_is_released', '=', False)]"/>
            </field>
            <filter name="group_by_product" position="after">
                <filter string="Released for Reuse" name="sh_group_by_released"
                        domain="[]" context="{'group_by': 'sh_is_released'}"/>
                <filter string="Serial No Prefix" name="sh_group_by_prefix"
                        domain="[]" context="{'group_by': 'sh_config_prifix_type'}"/>
            </filter>
        </field>
    </record>
</odoo>
