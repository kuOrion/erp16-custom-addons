<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_with_sample_invoice_button" model="ir.ui.view">
        <field name="name">account.sample.form.report.button</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Add the button in the header -->
            <xpath expr="//header" position="inside">
                <button name="%(orion_sample_invoice_report)d"
                        type="action"
                        string="Sample invoice"
                        class="btn btn-primary"
                        context="{'py3o_mimetype': 'odt'}"
                        groups="account.group_account_invoice"/>
            </xpath>
        </field>
    </record>
</odoo>
