<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_orion_select_product_wizard_form" model="ir.ui.view">
            <field name="name">orion.select.product.wizard.form</field>
            <field name="model">orion.select.product.wizard</field>
            <field name="arch" type="xml">
                <form string="Select Product">
                    <group>
                        <field name="production_id" invisible="1"/>
                        <field name="available_product_ids" invisible="1"/>
                        <field name="product_id" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <footer>
                        <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>