<odoo>
    <record id="py3o_mfgpending" model="ir.actions.report">
        <field name="name">Manufacturing Pending Report</field>
        <field name="type">ir.actions.report</field>
        <field name="model">mfgpending</field> <!-- Change to the relevant model -->
        <field name="report_name">orion_mfg_pending.py3o_mfgpending</field>
        <field name="report_type">py3o</field>
        <field name="py3o_filetype">odt</field>
        <field name="module">orion_mfg_pending</field>
        <field name="py3o_template_fallback">reports/product_pending.odt</field>
        <field name="print_report_name">
            'MO_Pending_%s_TO_%s' % (
            object.from_date.strftime("%d_%b_%Y").lower(),
            object.to_date.strftime("%d_%b_%Y").lower()
            )
        </field>
        <field name="binding_type">report</field>
    </record>
</odoo>