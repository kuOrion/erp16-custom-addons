<odoo>
    <record id="view_move_form_inherit_packing_list" model="ir.ui.view">
        <field name="name">account.move.form.inherit.packing.list</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[last()]" position="after">
                <page string="Packing List">
                    <group>
                        <field name="x_total_boxes"/>
                    </group>
                    <group>
                        <field name="box_ids">
                            <tree editable="bottom">
                                <field name="box_number"/>
                                <field name="length"/>
                                <field name="width"/>
                                <field name="height"/>
                                <field name="gross_weight"/>
                            </tree>
                        </field>
                        <field name="total_gross_weight" readonly="1" class="o_field_number"/>
                        <field name="x_net_weight"/>

                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
