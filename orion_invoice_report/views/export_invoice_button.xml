<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_with_export_invoice_list_button" model="ir.ui.view">
        <field name="name">account.move.form.export.tax.invoice.report.button</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Add the button in the header -->
            <xpath expr="//header" position="inside">
                <button name="%(action_report_invoice_py3o)d"
                        type="action"
                        string="Export Invoice"
                        class="btn btn-primary"
                        context="{'py3o_mimetype': 'odt'}"
                        groups="account.group_account_invoice"/>
            </xpath>
        </field>
    </record>
</odoo>
