<odoo>
    <record id="res_config_settings_view_form_proforma" model="ir.ui.view">
        <field name="name">res.config.settings.proforma.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <!-- This xpath targets the Invoicing section in Sale settings -->
            <xpath expr="//div[hasclass('settings')]//h2[contains(., 'Invoicing')]" position="after">
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="proforma_prefix" string="Proforma Prefix"/>
                            <div class="text-muted">
                                Prefix used for generating Proforma Invoice numbers (e.g. PI)
                            </div>
                            <div class="mt8">
                                <field name="proforma_prefix" placeholder="PI"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>

        </field>
    </record>
</odoo>