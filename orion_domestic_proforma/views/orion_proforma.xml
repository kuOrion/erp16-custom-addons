<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Orion Proforma Report -->
    <record id="report_orion_sale_proforma" model="ir.actions.report">
        <field name="name">Orion Domestic Proforma</field>
        <field name="type">ir.actions.report</field>
        <field name="model">sale.order</field>
        <field name="report_name">orion_domestic_proforma.report_proforma</field>
        <field name="report_type">py3o</field>
        <field name="py3o_filetype">pdf</field>
        <field name="module">orion_domestic_proforma</field>
        <field name="py3o_template_fallback">reports/orion_proforma_report.odt</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <!--        <field name="print_report_name">'%s' % object.name</field>-->
        <field name="print_report_name">(object.name[5:])</field>
        <field name="binding_type">report</field>
    </record>

</odoo>
