<odoo>
    <record id="view_mrp_bom_form_inherit_cost" model="ir.ui.view">
        <field name="name">mrp.bom.form.inherit.cost</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">

            <!-- Add Cost column after Quantity -->
            <xpath expr="//field[@name='bom_line_ids']/tree/field[@name='product_qty']"
                   position="after">
                <field name="component_cost" widget="monetary"/>
            </xpath>

        </field>
    </record>
</odoo>
