<odoo>
    <data>
        <record id="view_product_product_form_inherit_specification" model="ir.ui.view">
            <field name="name">product.product.form.inherit.specification</field>
            <field name="model">product.product</field>
            <field name="inherit_id"
                   ref="product.product_normal_form_view"/> <!-- Ensure this is the correct parent view -->
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page name="specification_page" string="Specifications">

                        <group>
                            <group>
                                <field name="model_name"/>
                                <field name="bulletin_no"/>
                                <field name="short_name"/>
                                <field name="range_code"/>
                                <field name="on_off_diff"/>
                                <field name="differential_temp"/>
                                <field name="max_pressure_temp"/>
                                <field name="repeatability"/>
                                <field name="photo_jpg"/>
                                <field name="pressure_port"/>
                                <field name="pressure_housing"/>
                                <field name="cable_entry"/>
                            </group>
                            <group>
                                <field name="model_enhancements"/>
                                <field name="enclosure"/>
                                <field name="range_scale"/>
                                <field name="switch_type"/>
                                <field name="base_type"/>
                                <field name="diaphragm"/>
                                <field name="micro_switch"/>
                                <field name="wetted_parts"/>
                                <field name="other_wetted_parts"/>
                                <field name="protective_cap"/>
                                <field name="calibration"/>
                                <field name="capillary"/>
                                <field name="bulb_connection"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
