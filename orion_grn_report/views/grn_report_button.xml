<odoo>
    <record id="stock_picking_form_inherit_grn_report_button" model="ir.ui.view">
        <field name="name">stock.picking.form.grn.report.button</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button name="%(report_orion_purchase_grn)d"
                        type="action"
                        string="GRN Report"
                        class="btn btn-secondary"
                        context="{'py3o_mimetype': 'odt'}"
                        groups="stock.group_stock_user"
                        attrs="{'invisible':[('picking_type_code','!=','incoming')]}"/>
            </xpath>

        </field>
    </record>
</odoo>