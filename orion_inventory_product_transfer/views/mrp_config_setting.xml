<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_inherit_route" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.route</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
            <field name="priority">55</field>
            <field name="arch" type="xml">
                <xpath expr="//div[@id='production_lot_info']" position="after">
                    <h2>Product Route Transfer Configuration</h2>
                    <div class="row mt16 o_settings_container" id="td_product_route_configure">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Manufactured PDI Location</span>
                                <div class="text-muted">
                                    Set default PDI location
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="td_manufactured_location_id"
                                               options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">FG Location</span>
                                <div class="text-muted">
                                    Set default Finished Goods location
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="td_fg_location_id"
                                               options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Stock Location</span>
                                <div class="text-muted">
                                    Set default Stock location
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="td_stock_location_id"
                                               options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
